{{> header title="Order Delivered" }}

<mj-section background-color="#fafafa">
    <mj-column>
        <mj-text font-size="20px" font-weight="bold" color="#2e7d32">
            Your Order Has Been Delivered!
        </mj-text>
        <mj-text color="#525252" font-size="15px" line-height="1.6">
            Dear {{ order.customer.firstName }} {{ order.customer.lastName }},
        </mj-text>
        <mj-text color="#525252" font-size="15px" line-height="1.6">
            Great news! Your order <strong>#{{ order.code }}</strong> has been marked as delivered.
        </mj-text>
    </mj-column>
</mj-section>

<mj-section background-color="#ffffff">
    <mj-column>
        <mj-text font-size="16px" font-weight="bold" color="#333333">
            Delivered Items:
        </mj-text>
        <mj-table cellpadding="6px">
            {{#each order.lines }}
                <tr style="border-bottom: 1px dashed #eee;">
                    <td style="padding: 8px 0;">{{ quantity }} x {{ productVariant.name }}</td>
                    <td style="text-align: right; padding: 8px 0;">{{ formatMoney discountedLinePriceWithTax ../order.currencyCode 'en' }}</td>
                </tr>
            {{/each}}
        </mj-table>
        <mj-text color="#525252" font-size="14px" line-height="1.5">
            We hope you enjoy your purchase! If you have any feedback or concerns regarding your order, please don't hesitate to reach out.
        </mj-text>
        <mj-button font-family="Helvetica, Arial, sans-serif"
                   background-color="#375a67"
                   color="white"
                   border-radius="4px"
                   font-size="15px"
                   href="{{ storefrontUrl }}">
            Visit Store
        </mj-button>
    </mj-column>
</mj-section>

{{> footer }}
