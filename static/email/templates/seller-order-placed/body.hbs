{{> header title="New Order Received" }}

<mj-section background-color="#fafafa">
    <mj-column>
        <mj-text font-size="20px" font-weight="bold" color="#375a67">
            [Seller Notification] New Order #{{ order.code }}
        </mj-text>
        <mj-text color="#525252" font-size="15px" line-height="1.6">
            A new order has been placed and payment settled on your store/channel.
        </mj-text>
        <mj-text color="#525252" font-size="14px">
            <strong>Customer:</strong> {{ order.customer.firstName }} {{ order.customer.lastName }} ({{ order.customer.emailAddress }})<br/>
            <strong>Placed At:</strong> {{ formatDate order.orderPlacedAt }}
        </mj-text>
    </mj-column>
</mj-section>

<mj-section background-color="#ffffff">
    <mj-column>
        <mj-text font-size="16px" font-weight="bold" color="#333333">
            Ordered Items:
        </mj-text>
        <mj-table cellpadding="6px">
            {{#each order.lines }}
                <tr style="border-bottom: 1px dashed #eee;">
                    <td style="padding: 8px 0;">{{ quantity }} x {{ productVariant.name }} (SKU: {{ productVariant.sku }})</td>
                    <td style="text-align: right; padding: 8px 0;">{{ formatMoney discountedLinePriceWithTax ../order.currencyCode 'en' }}</td>
                </tr>
            {{/each}}
            <tr style="font-weight: bold;">
                <td style="padding: 10px 0;">Order Total:</td>
                <td style="text-align: right; padding: 10px 0;">{{ formatMoney order.totalWithTax order.currencyCode 'en' }}</td>
            </tr>
        </mj-table>
        <mj-button font-family="Helvetica, Arial, sans-serif"
                   background-color="#375a67"
                   color="white"
                   border-radius="4px"
                   font-size="15px"
                   href="{{ adminUrl }}/admin/orders/{{ order.id }}">
            View in Admin Dashboard
        </mj-button>
    </mj-column>
</mj-section>

{{> footer }}
