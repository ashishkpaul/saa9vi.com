{{> header title="Password Reset Successful" }}

<mj-section background-color="#fafafa">
    <mj-column>
        <mj-text font-size="20px" font-weight="bold" color="#2e7d32">
            Password Successfully Reset
        </mj-text>
        <mj-text color="#525252" font-size="15px" line-height="1.6">
            The password associated with your account <strong>{{ user.identifier }}</strong> was recently changed.
        </mj-text>
        <mj-text color="#525252" font-size="15px" line-height="1.6">
            You can now log in using your new credentials.
        </mj-text>
        <mj-button font-family="Helvetica, Arial, sans-serif"
                   background-color="#375a67"
                   color="white"
                   border-radius="4px"
                   font-size="15px"
                   href="{{ storefrontUrl }}/login">
            Log In Now
        </mj-button>
        <mj-text color="#d32f2f" font-size="13px" line-height="1.5">
            If you did not make this change, please contact our support team immediately to secure your account.
        </mj-text>
    </mj-column>
</mj-section>

{{> footer }}
