{{> header title="Order Cancellation" }}

<mj-section background-color="#fafafa">
    <mj-column>
        <mj-text font-size="20px" font-weight="bold" color="#d32f2f">
            Order #{{ order.code }} Cancelled
        </mj-text>
        <mj-text color="#525252" font-size="15px" line-height="1.6">
            Dear {{ order.customer.firstName }} {{ order.customer.lastName }},
        </mj-text>
        <mj-text color="#525252" font-size="15px" line-height="1.6">
            Your order <strong>#{{ order.code }}</strong> has been cancelled. If you have already been charged, a refund will be processed to your original payment method.
        </mj-text>
    </mj-column>
</mj-section>

<mj-section background-color="#ffffff">
    <mj-column>
        <mj-text font-size="16px" font-weight="bold" color="#333333">
            Cancelled Items:
        </mj-text>
        <mj-table cellpadding="6px">
            {{#each order.lines }}
                <tr style="border-bottom: 1px dashed #eee;">
                    <td style="padding: 8px 0;">{{ quantity }} x {{ productVariant.name }}</td>
                    <td style="text-align: right; padding: 8px 0;">{{ formatMoney discountedLinePriceWithTax ../order.currencyCode 'en' }}</td>
                </tr>
            {{/each}}
            <tr style="font-weight: bold;">
                <td style="padding: 10px 0;">Order Total:</td>
                <td style="text-align: right; padding: 10px 0;">{{ formatMoney order.totalWithTax order.currencyCode 'en' }}</td>
            </tr>
        </mj-table>
        <mj-text color="#777777" font-size="13px" line-height="1.5">
            If you have any questions or if you believe this was done in error, please contact our support team.
        </mj-text>
    </mj-column>
</mj-section>

{{> footer }}
