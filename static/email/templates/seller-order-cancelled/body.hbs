{{> header title="Order Cancelled Notification" }}

<mj-section background-color="#fafafa">
    <mj-column>
        <mj-text font-size="20px" font-weight="bold" color="#d32f2f">
            [Seller Notification] Order #{{ order.code }} Cancelled
        </mj-text>
        <mj-text color="#525252" font-size="15px" line-height="1.6">
            Order <strong>#{{ order.code }}</strong> has been cancelled. Please ensure any pending processing or packing is halted.
        </mj-text>
        <mj-button font-family="Helvetica, Arial, sans-serif"
                   background-color="#375a67"
                   color="white"
                   border-radius="4px"
                   font-size="15px"
                   href="{{ adminUrl }}/admin/orders/{{ order.id }}">
            View in Admin
        </mj-button>
    </mj-column>
</mj-section>

{{> footer }}
