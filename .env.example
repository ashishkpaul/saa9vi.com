# ─────────────────────────────────────────────────────────────────────────────
# Payment integration — Razorpay (ADR-038/ADR-040)
#
# Secrets live HERE only. They are never stored in plugin config or the
# database (a handler config arg would be persisted and readable through the
# Admin API). See src/plugins/payments/constants.ts.
# ─────────────────────────────────────────────────────────────────────────────
#
# ONE-TIME commerce (R3) — Orders/Payments API keys from the Razorpay dashboard.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# RECURRING billing (R2) — webhook signing secret for
#   POST /payments/razorpay/webhook
# Fail-closed: when empty, the verifier rejects ALL webhook traffic.
RAZORPAY_WEBHOOK_SECRET=

# ONE-TIME commerce (R3) — webhook signing secret for
#   POST /payments/razorpay/checkout-webhook
# Optional: falls back to RAZORPAY_WEBHOOK_SECRET when unset, so a single
# Razorpay account can drive both endpoints.
RAZORPAY_PAYMENTS_WEBHOOK_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Platform secrets — required in any non-dev deployment (V1.0.9)
#
# `src/vendure-config.ts` now REFUSES TO START when APP_ENV is not "dev" and
# either secret below is unset, instead of falling back to the published
# defaults ("superadmin" / "cookie-secret-dev-fallback"). Rotate these in every
# deployment that ever ran with a default.
# ─────────────────────────────────────────────────────────────────────────────
# APP_ENV=dev enables the dev fallbacks and dev-only API debug options.
APP_ENV=
# SuperAdmin bootstrap credentials (seeded on first start).
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=
# Signing secret for session cookies (required — `authOptions.tokenMethod`
# includes "cookie"). Generate with: openssl rand -hex 32
COOKIE_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Infrastructure variables (DB_HOST, REDIS_HOST, BBB_*, …) are documented in
# README.md under "Running Vendure" — this file only covers the payment keys.
# ─────────────────────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────────────────────
# BBB metered billing — ADR-047 / Q2 (production-readiness item 1)
#
# Explicit platform rate in paise per learner-hour, applied to `metered`
# organizations that have no per-organization rate. REQUIRED in any non-dev
# deployment: boot REFUSES to start without it (assertProductionSecrets), so
# no production customer can ever be billed the clearly-marked ₹20 PLACEHOLDER
# (src/plugins/bigbluebutton-plugin/constants.ts TODO(PRICE)).
# Example: 2000 = ₹20 per learner-hour. 0 is valid ("bill nothing").
# ─────────────────────────────────────────────────────────────────────────────
BBB_DEFAULT_RATE_PAISE_PER_LEARNER_HOUR=

# ─────────────────────────────────────────────────────────────────────────────
# BBB webhooks — public callback base (W3/W4)
#
# Publicly reachable base URL of this instance (scheme + host). BBB hook
# registration builds callbacks as <base>/bbb/webhook/<serverId>, and BBB
# signs the URL that was REGISTERED — so this must be exactly the host the
# BBB server can reach (Cloudflare Tunnel / staging host, never an internal
# LAN name), and changing it later requires re-registering the hooks.
# REQUIRED in any non-dev deployment: boot refuses without it
# (assertProductionSecrets / BBB_PUBLIC_BASE_URL), and non-dev requires
# https:// — plain http is refused at boot (W4).
# Example: https://meeting.saa9vi.com
# ─────────────────────────────────────────────────────────────────────────────
BBB_PUBLIC_BASE_URL=

# ─────────────────────────────────────────────────────────────────────────────
# BBB operator alert channel (production-readiness items 4 + 6)
#
# Fire-and-forget JSON POST (Slack / Discord / PagerDuty incoming webhook) for
# `immediate` capacity alerts and the 90%-of-spend-limit approach warning.
# Optional: unset keeps the always-on Logger.warn channel only (log-based
# alerting); a failed/missing webhook degrades gracefully, never silently.
# ─────────────────────────────────────────────────────────────────────────────
OPS_ALERT_WEBHOOK_URL=

