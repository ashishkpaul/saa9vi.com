{
  "compilerOptions": {
    "composite": true,
    // The project compiles node_modules SOURCES (accepted baseline includes
    // @vendure/dashboard src). @vendure-io/ui 1.3.0 — pulled in by
    // @vendure/dashboard 3.7.4 — uses Map iteration that trips TS2802 under
    // tsc's implicit ES5 default. `downlevelIteration` clears it WITHOUT
    // changing target/lib (raising the target instead shifted the per-file
    // ratchet elsewhere — verified). Emit is unused: checks run --noEmit.
    "downlevelIteration": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "paths": {
      "@/gql": [
        "./src/gql/graphql.ts"
      ],
      "@/vdb/*": [
        "./node_modules/@vendure/dashboard/src/lib/*"
      ]
    }
  },
  "include": [
    "src/plugins/**/dashboard/**/*",
    "src/gql/**/*.ts",
    "vite.*.*ts"
  ]
}
