{
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "downlevelIteration": true,
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "paths": {
      "@/gql": [
        "./src/gql/graphql.ts"
      ],
      "@/vdb/*": [
        "./node_modules/@vendure/dashboard/src/lib/*"
      ]
    }
  },
  "include": [
    "src/plugins/**/dashboard/**/*",
    "src/gql/**/*.ts",
    "src/platform/dashboard/nav-main.tsx",
    "vite.*.*ts"
  ]
}
