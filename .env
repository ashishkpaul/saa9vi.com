# ─── BBB Scalability & Performance Tuning ─────────────────────────────
# Lock TTL (seconds) for distributed room provisioning locks
# BBB_LOCK_TTL_SECONDS=30
# Heartbeat interval (ms) for extending lock during long provisioning
# BBB_LOCK_HEARTBEAT_INTERVAL_MS=10000
# Lock strict mode: when true, Redis failure blocks provisioning
# BBB_ROOM_LOCK_STRICT=false

# Debounce window (ms): suppresses rapid re-provision requests
# BBB_PROVISION_DEBOUNCE_MS=15000
# Runtime validation cache TTL (ms): avoids hammering BBB APIs
# BBB_RUNTIME_VALIDATION_TTL_MS=10000
# Max auto-retries before room requires manual reset
# BBB_MAX_AUTO_RETRIES=3
# Grace period (ms): trust DB state after provisioning
# BBB_MEETING_GRACE_PERIOD_MS=90000

# Stuck provisioning timeout (ms) before reconciliation acts
# BBB_STUCK_PROVISIONING_TIMEOUT_MS=300000
# Fair billing min duration (ms): sessions under this are free
# BBB_FAIR_BILLING_MIN_DURATION_MS=120000
# Room stale timeout (ms): reset Provisioning rooms with no meeting
# BBB_ROOM_STALE_TIMEOUT_MS=300000

# Provisioning job retries and backoff (ms)
# BBB_PROVISIONING_JOB_RETRIES=3
# BBB_PROVISIONING_JOB_BACKOFF_MS=5000

# ─── Redis (for BullMQ Job Queue) ───────────────────────────────────────
# docker-compose maps Redis internally to 6379 but exposes as 6479 on the host
REDIS_HOST=localhost
REDIS_PORT=6479
REDIS_PASSWORD=your_strong_password

